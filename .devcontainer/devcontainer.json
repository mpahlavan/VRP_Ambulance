{
    "name": "PVRP GPU Container",
    "runArgs": ["--gpus", "all"],
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/py_ws/marpdan,type=bind",
    "workspaceFolder": "/py_ws/marpdan"
}